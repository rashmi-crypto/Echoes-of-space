# Echoes of Space - Environment Configuration Template
# Duplicate this file as .env.local for local overrides.
#
# Scientific Data Integrity Note:
# Echoes of Space utilizes open NASA planetary datasets (LROC WAC, LOLA DEM, LROC NAC geodesy).
# No external commercial API keys or third-party tokens are required to run this application locally.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Exploration Target ('moon')
NEXT_PUBLIC_DEFAULT_CELESTIAL_BODY=moon
